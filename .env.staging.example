# ── Staging frontend env — Vercel: Preview scope ────────────────────────────────
# REFERENCE template. The deploy reads from Vercel → Settings → Environment Variables
# (scope: Preview), NOT from this file. Use it as a fill-in checklist.

BACKEND_URL=                       # https://groovia-api-staging.onrender.com  (server-side only — NOT public)
NEXT_PUBLIC_SUPABASE_URL=          # staging Project URL (same value as the backend's SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # staging anon / "publishable" key (browser-safe)

# Optional:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=    # leave BLANK to disable reCAPTCHA on staging
